config {
  "type": "incremental",
  "schema": "silver",
  "name": "account_districts_quarantine",
  "description": "Rows of account_districts that failed a check, kept apart by daian.",
  "tags": [
    "daian",
    "daian-bi-test-bird-accounts"
  ]
}

SELECT *, 'not_null account_id' AS _failed_check, CURRENT_TIMESTAMP() AS _quarantined_at
FROM (
SELECT
  SAFE_CAST(a.`account_id` AS INT64) AS account_id,
  SAFE_CAST(a.`date` AS DATE) AS opening_date,
  CASE TRIM(a.`frequency`)
    WHEN 'POPLATEK MESICNE' THEN 'monthly'
    WHEN 'POPLATEK TYDNE' THEN 'weekly'
    WHEN 'POPLATEK PO OBRATU' THEN 'after transaction'
  END AS statement_frequency,
  d.`A2` AS district_name,
  d.`A3` AS region,
  SAFE_CAST(d.`A4` AS INT64) AS inhabitants
FROM ${ref("bird_cloud_account")} AS a
LEFT JOIN ${ref("bird_cloud_district")} AS d
  ON SAFE_CAST(d.`district_id` AS INT64) = SAFE_CAST(a.`district_id` AS INT64)
QUALIFY ROW_NUMBER() OVER (PARTITION BY SAFE_CAST(a.`account_id` AS INT64) ORDER BY SAFE_CAST(a.`date` AS DATE) DESC) = 1
)
WHERE NOT (`account_id` IS NOT NULL)
UNION ALL
SELECT *, 'not_null opening_date, district_name, region, inhabitants' AS _failed_check, CURRENT_TIMESTAMP() AS _quarantined_at
FROM (
SELECT
  SAFE_CAST(a.`account_id` AS INT64) AS account_id,
  SAFE_CAST(a.`date` AS DATE) AS opening_date,
  CASE TRIM(a.`frequency`)
    WHEN 'POPLATEK MESICNE' THEN 'monthly'
    WHEN 'POPLATEK TYDNE' THEN 'weekly'
    WHEN 'POPLATEK PO OBRATU' THEN 'after transaction'
  END AS statement_frequency,
  d.`A2` AS district_name,
  d.`A3` AS region,
  SAFE_CAST(d.`A4` AS INT64) AS inhabitants
FROM ${ref("bird_cloud_account")} AS a
LEFT JOIN ${ref("bird_cloud_district")} AS d
  ON SAFE_CAST(d.`district_id` AS INT64) = SAFE_CAST(a.`district_id` AS INT64)
QUALIFY ROW_NUMBER() OVER (PARTITION BY SAFE_CAST(a.`account_id` AS INT64) ORDER BY SAFE_CAST(a.`date` AS DATE) DESC) = 1
)
WHERE NOT (`opening_date` IS NOT NULL AND `district_name` IS NOT NULL AND `region` IS NOT NULL AND `inhabitants` IS NOT NULL)
UNION ALL
SELECT *, 'accepted_values statement_frequency in monthly, weekly, after transaction' AS _failed_check, CURRENT_TIMESTAMP() AS _quarantined_at
FROM (
SELECT
  SAFE_CAST(a.`account_id` AS INT64) AS account_id,
  SAFE_CAST(a.`date` AS DATE) AS opening_date,
  CASE TRIM(a.`frequency`)
    WHEN 'POPLATEK MESICNE' THEN 'monthly'
    WHEN 'POPLATEK TYDNE' THEN 'weekly'
    WHEN 'POPLATEK PO OBRATU' THEN 'after transaction'
  END AS statement_frequency,
  d.`A2` AS district_name,
  d.`A3` AS region,
  SAFE_CAST(d.`A4` AS INT64) AS inhabitants
FROM ${ref("bird_cloud_account")} AS a
LEFT JOIN ${ref("bird_cloud_district")} AS d
  ON SAFE_CAST(d.`district_id` AS INT64) = SAFE_CAST(a.`district_id` AS INT64)
QUALIFY ROW_NUMBER() OVER (PARTITION BY SAFE_CAST(a.`account_id` AS INT64) ORDER BY SAFE_CAST(a.`date` AS DATE) DESC) = 1
)
WHERE NOT ((`statement_frequency` IS NULL OR `statement_frequency` IN ('monthly', 'weekly', 'after transaction')))
